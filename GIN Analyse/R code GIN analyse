alpha_resultaten <- lapply(schaal_definities, function(s) {
  psych::alpha(as.data.frame(data[, s$items]), keys = s$keys, warnings = FALSE)
})

# Report alpha alongside the item-rest correlations, so you can see why a scale
# is weak before deciding to drop an item.
alpha_overzicht <- lapply(names(alpha_resultaten), function(nm) {
  a <- alpha_resultaten[[nm]]
  data.frame(
    schaal      = nm,
    n_items     = length(schaal_definities[[nm]]$items),
    n_omgekeerd = sum(schaal_definities[[nm]]$keys == -1),
    raw_alpha   = round(a$total$raw_alpha, 2),
    std_alpha   = round(a$total$std.alpha, 2),
    gem_r_drop  = round(mean(a$item.stats$r.drop, na.rm = TRUE), 2),
    row.names   = NULL
  )
}) |> bind_rows()

alpha_overzicht

# Item-rest correlations per scale, for the appendix.
lapply(alpha_resultaten, function(a) round(a$item.stats[, c("r", "r.drop")], 2))
