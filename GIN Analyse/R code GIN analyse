# 8. Regressiemodellen (gewogen LPM)

```{r stap8-helpers}
# One estimator, one place. FAMILIE is set at the top of the script.
fit_model <- function(dv, predictors, design) {
  form <- as.formula(paste(dv, "~", paste(predictors, collapse = " + ")))
  svyglm(form, design = design, family = FAMILIE)
}

# Under logit a perfectly predicting dummy breaks estimation. The LPM has no
# such problem, so this check only excludes variables when the estimator is
# logistic.
check_separatie <- function(var, dv, data) {
  any(table(data[[var]], data[[dv]]) == 0)
}

veilige_controles <- function(dv) {
  if (!SEPARATIE_UITSLUITEN) return(controlevars)
  risico <- sapply(missingness_dummies, check_separatie, dv = dv, data = data)
  if (any(risico)) {
    message("Uitgesloten wegens quasi-complete separatie met ", dv, ": ",
            paste(names(risico)[risico], collapse = ", "))
  }
  setdiff(controlevars, names(risico)[risico])
}

ster <- function(p) dplyr::case_when(
  p < .001 ~ "***", p < .01 ~ "**", p < .05 ~ "*", p < .10 ~ "†", TRUE ~ ""
)

tidy_b <- function(model) {
  s <- summary(model)$coefficients
  data.frame(
    term = rownames(s),
    b    = s[, "Estimate"],
    se   = s[, "Std. Error"],
    p    = s[, "Pr(>|t|)"],
    row.names = NULL
  )
}

fmt <- function(b, se, p) {
  ifelse(is.na(b), "–",
         paste0(sprintf("%.2f", b), ster(p), " (", sprintf("%.2f", se), ")"))
}

# The one diagnostic an LPM owes the reader: how often does it predict a
# probability outside [0, 1]?
lpm_bereik <- function(model) {
  f <- fitted(model)
  round(100 * mean(f < 0 | f > 1), 1)
}
```

