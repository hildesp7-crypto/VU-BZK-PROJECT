# VIF is computed on an unweighted glm with the SAME family as the survey
# models, so the diagnostic matches the models it describes.
vif_overzicht <- lapply(names(modellen_uitkomst), function(naam) {
  model <- modellen_uitkomst[[naam]]
  tryCatch(
    car::vif(glm(formula(model), data = data, family = FAMILIE)),
    error = function(e) {
      message("VIF overgeslagen voor '", naam, "': ", conditionMessage(e))
      NULL
    }
  )
})
names(vif_overzicht) <- names(modellen_uitkomst)

vif_naar_df <- function(v, naam) {
  if (is.null(v)) return(NULL)
  if (is.matrix(v)) {
    data.frame(variabele = rownames(v), waarde = v[, "GVIF^(1/(2*Df))"],
               model = naam, row.names = NULL)
  } else {
    # With 1 df, sqrt(VIF) equals GVIF^(1/(2*Df)).
    data.frame(variabele = names(v), waarde = sqrt(as.numeric(v)),
               model = naam, row.names = NULL)
  }
}

vif_tabel <- lapply(names(vif_overzicht), function(nm) {
  vif_naar_df(vif_overzicht[[nm]], nm)
}) |>
  bind_rows() |>
  mutate(waarde = gsub("\\.", ",", sprintf("%.2f", waarde))) |>
  tidyr::pivot_wider(names_from = model, values_from = waarde) |>
