# 2. Hercoderingen

```{r stap2-hercoderingen}
data <- data |>
  mutate(
    # ---- Leeftijd ----
    leeftijdsgroep = factor(
      case_when(
        leeftijd >= 18 & leeftijd <= 34 ~ "Jongvolwassen (18-34)",
        leeftijd >= 35 & leeftijd <= 64 ~ "Middelbaar volwassen (35-64)",
        leeftijd >= 65                  ~ "Senioren (65+)"
      ),
      levels = c("Jongvolwassen (18-34)", "Middelbaar volwassen (35-64)", "Senioren (65+)")
    ),

    # ---- Geslacht ----
    # A three-category variable must not enter the models as a number: coded
    # 1/2/3 it would impose equal steps from man to vrouw to overig. As a factor
    # with man as reference, the coefficient labelled "Vrouw" is the
    # man-vrouw difference, which is what the text claims.
    geslacht = factor(
      case_when(
        geslacht_raw == 1 ~ "Man",
        geslacht_raw == 2 ~ "Vrouw",
        geslacht_raw == 3 ~ "Overig"
      ),
      levels = c("Man", "Vrouw", "Overig")
    ),

    # ---- Religie ----
    religieus_cat = factor(
      case_when(
        religie == 1 ~ "Protestants",
        religie == 2 ~ "Katholiek",
        TRUE         ~ "Overig"
      ),
      levels = c("Overig", "Protestants", "Katholiek")
    ),
    religieus = case_when(
      religie_lid == 1 ~ 1,
      religie_lid == 0 ~ 0
    ),

    # ---- Koopwoning ----
    koopwoning = case_when(
      homeowner == 4               ~ 1,
      homeowner %in% c(1, 2, 3, 5) ~ 0
      # 997/999 fall through to NA
    ),

    # ---- Opleiding ----
    opleidingsniveau = factor(
      case_when(
        opleiding %in% 1:3 ~ "Laag",
        opleiding %in% 4:5 ~ "Midden",
        opleiding %in% 6:7 ~ "Hoog"
      ),
      levels = c("Laag", "Midden", "Hoog")
    ),

    # ---- Burgerlijke staat ----
    burgerlijke_staat = factor(
      case_when(
        mmarresp %in% c(1, 5, 6) ~ "Alleen",   # incl. gescheiden en verweduwd
        mmarresp == 4            ~ "Gehuwd",
        mmarresp == 2            ~ "Partner samenwonend",
        mmarresp == 3            ~ "Partner niet-samenwonend"
      ),
      levels = c("Alleen", "Gehuwd", "Partner samenwonend", "Partner niet-samenwonend")
    ),

    # ---- Stedelijkheid ----
    # Explicit levels with Dorpen first, so the reference category matches
    # what the paper says instead of depending on alphabetical order.
    stedelijkheid_cat = factor(
      case_when(
        stedelijkheid_wonen == 1      ~ "Grote steden",
        stedelijkheid_wonen == 2      ~ "Kleine steden",
        stedelijkheid_wonen %in% c(3, 4) ~ "Dorpen"
      ),
      levels = c("Dorpen", "Kleine steden", "Grote steden")
    ),

    # ---- Vertrouwen in de overheid ----
    vertrouwen_regering = if_else(
      as.numeric(vertrouwen_regering_raw) %in% 1:5,
      as.numeric(vertrouwen_regering_raw),
      NA_real_
    ),

    # ---- Kinderen ----
    kinderen = case_when(
      mchldc == 1            ~ 0,
      mchldc %in% c(2, 3, 4) ~ 1
    ),

    # ---- Gevraagd voor vrijwilligerswerk ----
    mvask2_dummy = case_when(
      mvask2 == 1 ~ 1,
      mvask2 == 0 ~ 0
    ),

    # ---- Lokale betrokkenheid (mbelong1, omgekeerd) ----
    lokale_betrokkenheid = 6 - mbelong1
  )
```

