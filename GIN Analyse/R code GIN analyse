```{r stap9-schatten}
maak_syntax <- function(x, m, covs = character(0)) {
  cov_str <- if (length(covs)) paste0(" + ", paste(covs, collapse = " + ")) else ""
  paste0(
    "any_buurtactiviteit ~ c_pad*", x, " + b_pad*", m, cov_str, "\n",
    m, " ~ a_pad*", x, cov_str, "\n",
    "direct        := c_pad\n",
    "indirect      := a_pad * b_pad\n",
    "total         := c_pad + (a_pad * b_pad)\n",
    "prop_mediated := (a_pad * b_pad) / (c_pad + (a_pad * b_pad))\n"
  )
}

run_mediatie <- function(x, m, covs, data, label) {
  vars <- unique(c(x, m, covs, "any_buurtactiviteit"))
  d <- data |> mutate(across(all_of(vars), as.numeric))
  tryCatch(
    sem(maak_syntax(x, m, covs), data = d,
        sampling.weights = "gewicht", se = "bootstrap", bootstrap = 1000),
    error = function(e) {
      message("FOUT bij ", label, ": ", conditionMessage(e))
      NULL
    }
  )
}

fits <- list()
for (nm in names(mediatie_paden)) {
  p <- mediatie_paden[[nm]]
  message("Bootstrapping: ", p$label)
  fits[[paste0(nm, "_stap1")]] <- run_mediatie(p$x, p$m, character(0), data, p$label)
  fits[[paste0(nm, "_stap2")]] <- run_mediatie(p$x, p$m, covariaten,  data, p$label)
}

overzicht_mediatie <- lapply(names(fits), function(nm) {
  fit <- fits[[nm]]
  if (is.null(fit)) return(NULL)
  basis <- sub("_stap[12]$", "", nm)
  pe <- parameterEstimates(fit, boot.ci.type = "bca.simple")
  pe <- pe[pe$label %in% c("direct", "indirect", "total", "prop_mediated"), ]
  data.frame(
    pad     = mediatie_paden[[basis]]$label,
    stap    = if (grepl("stap1$", nm)) "1. zonder covariaten" else "2. met eerdere participatie",
    effect  = pe$label,
    est     = round(pe$est, 3),
    se      = round(pe$se, 3),
    ci_laag = round(pe$ci.lower, 3),
    ci_hoog = round(pe$ci.upper, 3),
    p       = round(pe$pvalue, 3),
    row.names = NULL
  )
}) |> bind_rows()

